# Anthropic
ANTHROPIC_API_KEY=

# Database (Zeabur PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (限 gs.keichi.edu.hk domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# n8n WhatsApp webhook
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# 本地 LLM（可選）
OLLAMA_URL=http://localhost:11434
LMSTUDIO_URL=http://localhost:1234

# Google Service Account（Base64 encoded JSON key file）
# 用於 Google Drive 上載及 Google Calendar 代課事件
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# Admin bootstrap（首次部署後可刪除）
SETUP_TOKEN=

# Cron job（每週摘要）
CRON_SECRET=
WEEKLY_SUMMARY_RECIPIENTS=85291234567,85298765432
# AgentOS foundation adapters (optional; never use a private profile)
HERMES_PYTHON=
HERMES_SOURCE_DIR=
AGENTOS_HERMES_HOME=
AGENTOS_CODEX_COMMAND=
AGENTOS_CODEX_WORKSPACE=
AGENTOS_CODEX_HOME=
