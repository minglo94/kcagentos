# Copy to deploy/private/runtime.env with mode 0600; never commit real settings.
# Database password must be random hexadecimal so the URL remains unambiguous.
AGENTOS_DB_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AGENTOS_HTTP_PORT=3000
AGENTOS_DB_PORT=15432
AGENTOS_IMAGE_TAG=local
AGENTOS_LOCAL_AUTH_ENABLED=false
AGENTOS_AD_AUTH_ENABLED=false
AGENTOS_AD_ID=
AGENTOS_AD_URL=
AGENTOS_AD_BASE=
AGENTOS_AD_BIND_DN=
AGENTOS_AD_BIND_PASSWORD=
AGENTOS_AD_CA_FILE=
