generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  APPROVER
  DEPT_HEAD
  TEACHER
  OFFICE
}

enum TaskStatus {
  RUNNING
  DONE
  FAILED
  PENDING_APPROVAL
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum WaStatus {
  NOT_SENT
  SENT
  CONFIRMED
  DECLINED
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String
  role        Role       @default(TEACHER)
  department  String?
  subjects    String[]
  isActive    Boolean    @default(true)
  lastLoginAt DateTime?
  authRevision Int       @default(0)
  googleEnabled Boolean  @default(false)
  createdAt   DateTime   @default(now())
  tasks       Task[]
  documents   Document[]
  todos       Todo[]
  officeJobs  OfficeJob[]
  portalTeacherMappings PortalTeacherMapping[]
  localCredential LocalCredential?
  directoryIdentities DirectoryIdentity[]
}

model LocalCredential {
  userId       String @id
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  username     String @unique
  passwordHash String
}

model DirectoryIdentity {
  id          String @id @default(cuid())
  directoryId String
  objectGuid  String
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([directoryId, objectGuid])
  @@index([userId])
}

model LoginAttempt {
  key String @id
  windowStartedAt DateTime
  attempts Int
  @@index([windowStartedAt])
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Task {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  title     String
  agentId   String
  status    TaskStatus @default(RUNNING)
  createdAt DateTime   @default(now())
  document  Document?
}

model Document {
  id               String         @id @default(cuid())
  taskId           String         @unique
  task             Task           @relation(fields: [taskId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  title            String
  docType          String
  content          String         @db.Text
  approvalStatus   ApprovalStatus @default(NOT_REQUIRED)
  approvedBy       String?
  approvedAt       DateTime?
  rejectionReason  String?
  driveUrl         String?
  driveFileId      String?
  createdAt        DateTime       @default(now())
}

model Timetable {
  id          String  @id @default(cuid())
  teacherName String
  dayOfWeek   Int
  period      Int
  classCode   String?
  subject     String?
  term        String

  @@unique([teacherName, dayOfWeek, period, term])
}

model Template {
  id        String  @id @default(cuid())
  docType   String
  name      String
  content   String  @db.Text
  isDefault Boolean @default(false)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  agentId   String?
  engine    String
  docType   String?
  createdAt DateTime @default(now())
}

model SubstitutionRequest {
  id              String   @id @default(cuid())
  requesterName   String
  date            DateTime
  periods         Int[]
  classCode       String
  subject         String
  reason          String
  candidateName   String?
  candidateEmail  String?
  waStatus        WaStatus @default(NOT_SENT)
  calendarEventId String?
  createdAt       DateTime @default(now())
}

enum OfficeStatus {
  PLANNING
  PENDING_PLAN_APPROVAL
  QUEUED
  RUNNING
  WAITING_INPUT
  PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
}

model OfficeJob {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  goal            String       @db.Text
  executionPolicy Json?
  policyHash      String?
  team            String
  status          OfficeStatus @default(PLANNING)
  plan            Json?
  planHash        String?
  planVersion     Int          @default(0)
  approvedVersion Int?
  leaseToken      String?
  leaseUntil      DateTime?
  errorCode       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  steps           OfficeStep[]
  events          OfficeEvent[]
  approvals       OfficeApproval[]
  portalOperations PortalOperation[]
  teacherRequest PortalTeacherRequest?

  @@index([userId, createdAt])
  @@index([status, leaseUntil])
}

model OfficeStep {
  id          String    @id @default(cuid())
  jobId       String
  job         OfficeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  key         String
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  result      String?   @db.Text
  operationId String?
  updatedAt   DateTime  @updatedAt

  @@unique([jobId, key])
}

model OfficeEvent {
  id        Int       @id @default(autoincrement())
  jobId     String
  job       OfficeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type      String
  data      Json
  createdAt DateTime  @default(now())

  @@index([jobId, id])
}

model OfficeApproval {
  id          String    @id @default(cuid())
  jobId       String
  job         OfficeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  planVersion Int
  planHash    String
  actorId     String
  decision    String
  reason      String?
  createdAt   DateTime  @default(now())

  @@unique([jobId, planVersion])
}

model TaskAttempt {
  id            String @id
  invocationKey String @unique
  actorId       String
  parentId      String?
  jobId         String?
  stepId        String?
  policy        Json
  executor      String
  model         String?
  status        String @default("RUNNING")
  errorCode     String?
  leaseToken    String?
  planVersion   Int?
  deadline      DateTime
  createdAt     DateTime @default(now())
  finishedAt    DateTime?
  artifacts     TaskArtifact[]
  @@index([actorId, createdAt])
  @@index([jobId, status])
  @@index([status, deadline])
}

model TaskArtifact {
  id         String @id @default(cuid())
  attemptId  String
  attempt    TaskAttempt @relation(fields: [attemptId], references: [id])
  direction  String
  sequence   Int
  ref        String @unique
  sha256     String
  bytes      Int
  @@unique([attemptId, direction, sequence])
}

// References only. School evidence and authoritative approvals remain in Portal.
// Independent of OfficeStep so replanning cannot erase accepted operations.
model PortalOperation {
  id             String    @id @default(cuid())
  jobId          String
  job            OfficeJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  planVersion    Int
  stepKey        String
  idempotencyKey  String    @unique
  requestHash    String
  operationId    String?   @unique
  status         String    @default("UNSUBMITTED")
  revision       Int       @default(0)
  snapshot       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([jobId, planVersion, stepKey])
}

// Operator-provisioned identity links; never supplied or auto-created by ingress.
model PortalTeacherMapping {
  id String @id @default(cuid())
  issuer String
  portalStaffId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests PortalTeacherRequest[]
  @@unique([issuer, portalStaffId])
  @@unique([issuer, userId])
}
model PortalTeacherRequest {
  requestId String @id
  issuer String
  portalStaffId String
  mappingId String
  mapping PortalTeacherMapping @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  requestHash String
  jobId String @unique
  job OfficeJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  revision Int @default(0)
  snapshotHash String?
  createdAt DateTime @default(now())
  decisions PortalTeacherDecision[]
  commands PortalTeacherCommand[]
}
model PortalTeacherDecision {
  decisionId String @id
  requestId String
  request PortalTeacherRequest @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  decisionHash String
  planVersion Int
  planHash String
  decision String
  createdAt DateTime @default(now())
}
model PortalTeacherCommand {
  commandId String @id
  requestId String
  request PortalTeacherRequest @relation(fields: [requestId], references: [requestId], onDelete: Restrict)
  commandHash String
  action String
  createdAt DateTime @default(now())
}
model PortalTeacherNonce {
  issuer String
  nonce String
  createdAt DateTime @default(now())
  @@id([issuer, nonce])
}
